{
  "name": "saral",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "test": "node --test \"tools/**/*.test.mjs\" \"packages/**/*.test.mjs\"",
    "guard": "node tools/guard/guard.mjs --all && node tools/guard/guard.mjs --log HEAD && node tools/guard/guard.mjs --history HEAD",
    "build": "node packages/tokens/src/build.mjs",
    "check:dist": "node packages/tokens/src/build.mjs --check",
    "serve": "node tools/serve.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "types": "tsc -p tsconfig.types.json",
    "check:types": "npm run types && git diff --exit-code dist/types"
  },
  "version": "0.2.0",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    "./css/*": "./dist/css/*",
    "./tokens/*": "./dist/js/*",
    "./core": {
      "types": "./dist/types/core/src/index.d.mts",
      "default": "./packages/core/src/index.mjs"
    },
    "./react": {
      "types": "./dist/types/react/src/index.d.mts",
      "default": "./packages/react/src/index.mjs"
    }
  },
  "files": [
    "dist",
    "packages/core/src",
    "packages/react/src",
    "LICENSE",
    "README.md"
  ]
}
