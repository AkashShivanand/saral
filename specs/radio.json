{
  "status": "preview",
  "since": "0.3.0",
  "examples": [
    "fixtures/kit.html"
  ],
  "screenReaderLog": [],
  "name": "Radio group",
  "purpose": "One choice from a short list, all visible at once.",
  "whenToUse": [
    "Two to five options where seeing them all helps the choice"
  ],
  "whenNotToUse": [
    {
      "case": "More than about five options",
      "instead": "Select"
    },
    {
      "case": "Several options can be chosen",
      "instead": "Checkbox, one per option"
    }
  ],
  "anatomy": [
    {
      "part": "root",
      "element": "fieldset",
      "role": "group"
    },
    {
      "part": "label",
      "element": "legend",
      "role": "none"
    },
    {
      "part": "item",
      "element": "div",
      "role": "none"
    },
    {
      "part": "input",
      "element": "input type=radio",
      "role": "radio"
    },
    {
      "part": "item-label",
      "element": "label",
      "role": "none"
    },
    {
      "part": "hint",
      "element": "p",
      "role": "none"
    },
    {
      "part": "error",
      "element": "p",
      "role": "none"
    }
  ],
  "states": [
    {
      "state": "checked",
      "setBy": "css",
      "how": ":checked, drawn by the browser in accent-color"
    },
    {
      "state": "focus",
      "setBy": "css",
      "how": ":focus-visible"
    },
    {
      "state": "invalid without script",
      "setBy": "css",
      "how": ":user-invalid on a radio shows the error part"
    },
    {
      "state": "invalid with script",
      "setBy": "core",
      "how": "data-invalid on root; aria-invalid and aria-describedby on every radio. The group is checked only when focus leaves it."
    }
  ],
  "props": [
    {
      "name": "legend",
      "type": "string",
      "default": "required",
      "does": "The question the group answers"
    },
    {
      "name": "name",
      "type": "string",
      "default": "required",
      "does": "The form field name shared by every radio"
    },
    {
      "name": "options",
      "type": "{ value, label }[]",
      "default": "required",
      "does": "One radio per option"
    },
    {
      "name": "required",
      "type": "boolean",
      "default": "false",
      "does": "A choice must be made"
    },
    {
      "name": "defaultValue",
      "type": "string",
      "default": "none",
      "does": "The option chosen at the start"
    }
  ],
  "keyboard": [
    {
      "key": "Tab",
      "action": "Moves into and out of the group"
    },
    {
      "key": "Arrow keys",
      "action": "Move between options and choose"
    }
  ],
  "accessibility": {
    "web": "A native fieldset and legend name the group; each radio has its own label. Arrow keys move between options, as the browser provides.",
    "ios": "SwiftUI Picker with the inline style",
    "android": "Compose selectableGroup with RadioButton rows"
  },
  "tokens": [
    "action.default",
    "text.default",
    "text.muted",
    "feedback.danger.text",
    "border.focus",
    "size.target-min",
    "focus.width",
    "focus.offset"
  ],
  "content": "Ask the question in the legend: How should we reply? Keep option labels short."
}
